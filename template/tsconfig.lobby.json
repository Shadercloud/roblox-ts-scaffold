{
	// The lobby place: common + lobby. Compiled against lobby.project.json,
	// so an import of game code fails the build. Tests and stories are not part of a
	// shipping place: they build with tsconfig.test.json.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"rootDir": "src",
		"rootDirs": null
	},
	"include": ["src/common/**/*.ts", "src/common/**/*.tsx", "src/lobby/**/*.ts", "src/lobby/**/*.tsx"]
}
